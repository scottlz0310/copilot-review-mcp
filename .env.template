# review-raven — mcp-gateway required
# Standalone OAuth has been removed. Connect this server behind mcp-gateway.
# See README.md and docs/architecture.md for setup instructions.

# ── Core settings (defaults shown) ──────────────────────────────────────────

MCP_PORT=8083
# Bind address for the HTTP server. Default is 127.0.0.1 (loopback only) to prevent
# direct access without mcp-gateway. In Docker, set to 0.0.0.0 so the container is
# reachable from mcp-gateway on the same Docker network (or via published ports).
BIND_ADDR=127.0.0.1
LOG_LEVEL=info
SQLITE_PATH=/data/review-raven.db
IN_PROGRESS_THRESHOLD_SEC=30
# Streamable HTTP セッションの idle timeout（分）。
# 既定 0 = idle で閉じない（#14 対策）。DELETE を送らずに消えたクライアントの session は残るため、
# メモリ増加を抑えたい場合は正の値（例: 24 時間なら 1440）を指定する。
MCP_SESSION_TIMEOUT_MIN=0

# ── Phase B: mcp-gateway internal API (optional) ─────────────────────────────
# Enables gateway-backed token refresh for long-lived background watches.
# Both variables must be set together, or neither. The URL must be a loopback address.
# REVIEW_RAVEN_GATEWAY_INTERNAL_URL=http://127.0.0.1:8080/internal/v1/whoami
# REVIEW_RAVEN_GATEWAY_INTERNAL_SECRET=<shared-bearer-secret>

# ── Migration / Compatibility ─────────────────────────────────────────────────
# The following variable names were used in the former copilot-review-mcp release.
# They remain functional as fallbacks but are deprecated — migrate to the new names above.
#
# COPILOT_REVIEW_GATEWAY_INTERNAL_URL=http://127.0.0.1:8080/internal/v1/whoami
# COPILOT_REVIEW_GATEWAY_INTERNAL_SECRET=<shared-bearer-secret>
#
# If migrating an existing deployment with /data/copilot-review.db, set:
# SQLITE_PATH=/data/copilot-review.db
# Note: resource URIs stored in the old DB use the copilot-review://watch/{id} scheme,
# which is still accepted as a deprecated read/subscribe alias (see docs/architecture.md).
